# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored and will NEVER be committed.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role / secret key (server-only, bypasses RLS — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Developers -> API keys, TEST mode) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret (from `stripe listen` locally, or the
# Dashboard -> Developers -> Webhooks in production).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Base URL of the site (used for Stripe redirect URLs).
# In production set this to your deployed URL, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
